{
  "name": "hermes-x-dashboard-plugin",
  "private": true,
  "version": "2.0.0",
  "description": "Zero-cost Creator & Agent Command Center for X in Hermes Web Dashboard and Hermes Desktop",
  "type": "module",
  "scripts": {
    "build": "npm run build:dashboard && npm run build:desktop",
    "build:dashboard": "vite build",
    "build:desktop": "vite build --config vite.desktop.config.ts",
    "install:desktop": "node scripts/install-desktop.mjs",
    "pretest": "node test/build-test-bundle.mjs",
    "test": "node --experimental-strip-types --test \"test/*.test.mjs\"",
    "typecheck": "tsc -p . --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "jsdom": "^30.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
